{
  "name": "warehouse.ai-api-client",
  "version": "7.3.1",
  "description": "Node.JS API to communicate with warehouse.ai",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "lint": "prettier --write lib",
    "release": "commit-and-tag-version -t ''",
    "test": "tap 'lib/**/*.test.js'",
    "posttest": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:godaddy/warehouse.ai-api-client.git"
  },
  "keywords": [
    "warehouse",
    "sdk"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/godaddy/warehouse.ai-api-client/issues"
  },
  "homepage": "https://github.com/godaddy/warehouse.ai-api-client",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=7.6.0"
  },
  "dependencies": {
    "ms": "^2.1.3",
    "node-fetch": "^2.6.7",
    "tar": "^7.5.19",
    "tmp": "^0.2.1"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.2",
    "commit-and-tag-version": "^13.0.0",
    "nock": "^13.2.7",
    "prettier": "^2.7.1",
    "sinon": "^14.0.0",
    "tap": "^21.7.5"
  },
  "tap": {
    "allow-incomplete-coverage": true
  },
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true
  }
}
